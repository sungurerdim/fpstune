// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`'Hardware' page layout > at a narrow window (390px) 1`] = `
"viewport 390px
div [flex-wrap]
  h2 "Hardware"
  div [max-w-full]
    div [flex-wrap]
div#hardware-columns [grid-cols-1]
  div [flex-wrap]
    h3 "Example CPU 8-Core"
    div [max-w-full]
      div [flex-wrap]
    ul [flex-wrap]
  div [flex-wrap]
    h3 "Memory"
    div [max-w-full]
      div [flex-wrap]
    ul [flex-wrap]
  div [flex-wrap]
    h3 "Example GPU"
    div [max-w-full]
      div [flex-wrap]
    ul [flex-wrap]
  div [flex-wrap]
    h3 "Example Monitor"
    div [max-w-full]
      div [flex-wrap]
    ul [flex-wrap]
  div#monitor-modes [grid-cols-[max-content_minmax(0,1fr)]]
    div [flex-wrap]
    div [flex-wrap]
  div [flex-wrap]
    h3 "Ethernet"
    div [max-w-full]
      div [flex-wrap]
    ul [flex-wrap]
  div [flex-wrap]
    h3 "Audio"
    div [max-w-full]
      div [flex-wrap]
    ul [flex-wrap]
  h4 "Audio Output(1)"
  h4 "Audio Input""
`;

