{
  "minLines": 8,
  "minTokens": 60,
  "threshold": 0.5,
  "reporters": ["console"],
  "absolute": true,
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/dist/**",
    "**/build/**",
    "**/__pycache__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "tests/**",
    "frontend/e2e/**",
    "**/*.json",
    "**/*.md",
    "**/*.lock"
  ]
}
