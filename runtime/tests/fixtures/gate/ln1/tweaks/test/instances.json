{
  "kind": "tweak",
  "title": { "en": "Native output listed as instances", "tr": "Ornek olarak listelenen yerel cikti" },
  "why": { "en": "LN1 fixture: instances come from what an exe printed.", "tr": "LN1 fiksturu: ornekler bir exe ciktisindan gelir." },
  "fixed": { "en": "Fixture fixed.", "tr": "Fikstur duzeldi." },
  "risk": "safe",
  "sources": ["https://learn.microsoft.com/windows-server/administration/windows-commands/driverquery"],
  "gain": ["experience"],
  "instances": "driverquery /fo csv | ConvertFrom-Csv | ForEach-Object { [pscustomobject]@{ id = $_.'Module Name'; label = $_.'Module Name' } }",
  "detect": "[string](Get-ItemProperty -Path 'HKCU:\\Software\\FpsTuneFixture' -Name $Instance -ErrorAction Stop).$Instance",
  "target": { "value": "1" },
  "apply": "Set-ItemProperty -Path 'HKCU:\\Software\\FpsTuneFixture' -Name $Instance -Value $Target",
  "revert": "Remove-ItemProperty -Path 'HKCU:\\Software\\FpsTuneFixture' -Name $Instance -ErrorAction SilentlyContinue"
}
