// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`'Optimize' page layout > at a narrow window (390px) 1`] = `
"viewport 390px
div [max-w-xs]
div#category-section
  h2 "Software 2 of 2 not optimized"
    span#category-count
  div#category-section
    h3 "System 2 of 2 not optimized"
      span#category-count
    div#tweak-row
      span [max-w-[55%]]
    div#tweak-row
      span [max-w-[55%]]
div#category-section
  h2 "Hardware 2 of 2 not optimized"
    span#category-count
  h3 "Example CPU 8-CoreCPU"
  h3 "Memory"
  h3 "Example GPUGPU · 8 GB2 not optimized"
  h3 "Example MonitorMonitor 1 · primary · 2560×1440 @"
  h3 "EthernetEthernet"
  h3 "Audio"
div#category-section
  h2 "Games 2 of 2 not optimized"
    span#category-count
  div#category-section
    h3 "Modern Warfare IV 2 of 2 not optimized"
      span#category-count
    div#tweak-row
      span [max-w-[55%]]
    div#tweak-row
      span [max-w-[55%]]
div [flex-wrap]
  div [flex-wrap]"
`;

exports[`'Optimize' page layout > at a wide window (2560px) 1`] = `
"viewport 2560px
div [max-w-xs]
div#category-section
  h2 "Software 2 of 2 not optimized"
    span#category-count
  div#category-section
    h3 "System 2 of 2 not optimized"
      span#category-count
    div#tweak-row
      span [max-w-[55%]]
    div#tweak-row
      span [max-w-[55%]]
div#category-section
  h2 "Hardware 2 of 2 not optimized"
    span#category-count
  h3 "Example CPU 8-CoreCPU"
  h3 "Memory"
  h3 "Example GPUGPU · 8 GB2 not optimized"
  h3 "Example MonitorMonitor 1 · primary · 2560×1440 @"
  h3 "EthernetEthernet"
  h3 "Audio"
div#category-section
  h2 "Games 2 of 2 not optimized"
    span#category-count
  div#category-section
    h3 "Modern Warfare IV 2 of 2 not optimized"
      span#category-count
    div#tweak-row
      span [max-w-[55%]]
    div#tweak-row
      span [max-w-[55%]]
div [flex-wrap]
  div [flex-wrap]"
`;
