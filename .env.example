# fpstune environment variables
# Copy this file to .env and adjust values as needed.
# None of these are required for normal use — they are all optional overrides.

# Enable verbose debug logging for fpstune internals.
# Set to 1, true, yes, or on to enable.
FPSTUNE_DEBUG=0

# Suppress all ANSI colour output (useful in CI or terminals without colour support).
# Set to any non-empty value to disable colour.
NO_COLOR=

# Set automatically by pytest when running tests — do not set this manually.
# fpstune uses it to skip interactive startup behaviour during test runs.
# PYTEST_CURRENT_TEST=

# Standard Windows environment variables used as fallbacks.
# These are always set by Windows itself; only override for non-standard layouts.
# SYSTEMROOT=C:\Windows
# LOCALAPPDATA=%USERPROFILE%\AppData\Local
# USERPROFILE=C:\Users\YourName
