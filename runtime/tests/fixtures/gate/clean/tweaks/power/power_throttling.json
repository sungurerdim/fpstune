{
  "kind": "tweak",
  "title": { "en": "Turn off power throttling", "tr": "Guc kisitlamasini kapat" },
  "why": {
    "en": "Windows 11 can slow background work to save power, which can delay a game's helper threads.",
    "tr": "Windows 11 guc tasarrufu icin arka plan islerini yavaslatabilir, bu da oyunun yardimci islerini geciktirebilir."
  },
  "fixed": { "en": "Power throttling is now turned off.", "tr": "Guc kisitlamasi artik kapali." },
  "risk": "safe",
  "sources": ["https://learn.microsoft.com/windows/win32/procthread/quality-of-service"],
  "gain": ["fps", "latency"],
  "restart": "none",
  "applicable": "$true",
  "detect": "[string](Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling' -Name PowerThrottlingOff -ErrorAction Stop).PowerThrottlingOff",
  "target": { "value": 1 },
  "apply": "New-Item -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling' -Force | Out-Null; Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling' -Name PowerThrottlingOff -Value $Target -Type DWord",
  "revert": "Remove-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling' -Name PowerThrottlingOff -ErrorAction SilentlyContinue"
}
